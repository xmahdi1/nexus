{
  "name": "nexus-steward-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit --skipLibCheck",
    "preview": "vite preview",
    "lint": "eslint src tests *.ts *.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.mjs\" \"*.{ts,json,html,mjs}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.mjs\" \"*.{ts,json,html,mjs}\"",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.16.0",
    "@vueuse/core": "^15.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.2.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.4.5",
    "vue-sonner": "^1.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "10.16.0",
    "eslint-plugin-vue": "10.12.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tailwindcss": "^4.0.6",
    "typescript": "5.7.2",
    "typescript-eslint": "8.74.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8",
    "deepmerge": "4.1.1",
    "brace-expansion": "^5.0.13"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
