# Generate NEXUS_PASSWORD_HASH and NEXUS_ENCRYPTION_KEY by running:
#   go run ./cmd/nexus setup

NEXUS_PASSWORD_HASH=
NEXUS_ENCRYPTION_KEY=

# NEXUS_PORT=8080
# NEXUS_DB_PATH=nexus.db
# NEXUS_STATIC_DIR=../nexus-vue/dist

# Set to true ONLY when running behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Real-IP / X-Forwarded-Proto (https). When false (default), the client's real
# connection address is used, so login rate limiting cannot be bypassed by
# spoofing those headers.
# NEXUS_TRUST_PROXY=false

# Opaque session expiry. Both values must be between 1m and 720h; idle <= absolute.
# NEXUS_SESSION_IDLE_TTL=12h
# NEXUS_SESSION_ABSOLUTE_TTL=168h

# Opt-in preview: fixed read-only inventory on registered hosts. Off by default.
# Complete the deployment security/lab release checks before enabling.
# NEXUS_ENABLE_INVENTORY=false

# Opt-in scheduled task supervision. Requires root SSH, systemd, cgroup v2 and
# Python 3 on the managed Linux host. Existing tasks retain their execution mode.
# NEXUS_ENABLE_JOB_SUPERVISION=false
# Optional durable supervision for interactive Compose/container actions.
# When enabled, use operation controls; the legacy direct mutation routes refuse execution.
# NEXUS_ENABLE_OPERATION_SUPERVISION=false

# Optional Certbot ACME directory (HTTPS only); unset uses Let's Encrypt production.
# Set staging explicitly for testing. Does not alter Caddy's independent CA policy.
# NEXUS_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# Optional private CA bundle path ON EACH MANAGED HOST; requires an explicit directory.
# NEXUS_ACME_CA_FILE=/etc/nexus/acme-ca.pem

# Optional Vault UI (connection settings and per-request Vault tokens).
# NEXUS_ENABLE_VAULT=false
